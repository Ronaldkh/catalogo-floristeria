# Copia este archivo como .env y completa los valores.
# ID de la hoja (en la URL: /spreadsheets/d/<SHEET_ID>/edit)
SHEET_ID=

# Nombre exacto de la pestaña de la hoja
SHEET_TAB=catalogo

# Columnas a leer
SHEET_RANGE=A:Z

# Cada cuánto se relee la hoja (milisegundos, mínimo 15000)
POLL_INTERVAL_MS=45000

# Puerto expuesto en el host (LAN). El contenedor usa 3000 internamente.
APP_PORT=8080

# Zona horaria
TZ=America/Bogota

# Cloudflare Tunnel (opcional, para publicar en internet)
CLOUDFLARE_TUNNEL_TOKEN=
